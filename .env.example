# Application runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.0.0-local

# Local container ports and PostgreSQL bootstrap values
POSTGRES_PORT=5432
POSTGRES_DB=ipoint
POSTGRES_USER=ipoint
POSTGRES_PASSWORD=ipoint-local-only
REDIS_PORT=6379

# Application connections (local development only)
DATABASE_URL=postgresql://ipoint:ipoint-local-only@127.0.0.1:5432/ipoint
REDIS_URL=redis://127.0.0.1:6379

# Authentication development placeholders. Replace locally; never commit real values.
AUTH_OTP_PEPPER=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_IDEMPOTENCY_TTL_SECONDS=86400
AUTH_REGISTRATION_EMAIL_RATE_LIMIT_COUNT=3
AUTH_REGISTRATION_EMAIL_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTRATION_IP_RATE_LIMIT_COUNT=5
AUTH_REGISTRATION_IP_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_EMAIL_RATE_LIMIT_COUNT=5
AUTH_LOGIN_EMAIL_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_IP_RATE_LIMIT_COUNT=10
AUTH_LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_PASSWORD_RESET_EMAIL_RATE_LIMIT_COUNT=3
AUTH_PASSWORD_RESET_EMAIL_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_PASSWORD_RESET_IP_RATE_LIMIT_COUNT=5
AUTH_PASSWORD_RESET_IP_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_MEMBER_PUBLIC_ID_PREFIX=IPM
AUTH_MEMBER_PUBLIC_ID_LENGTH=10
AUTH_MEMBER_REFERRAL_CODE_LENGTH=8
