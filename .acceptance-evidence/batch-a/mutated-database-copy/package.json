{
  "name": "@ipoint/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seeds/foundation": "./seeds/foundation.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/schema.unit.test.ts",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "db:migrate": "tsx src/migration-runner.ts",
    "db:seed": "tsx seeds/index.ts",
    "db:checksum": "tsx src/migration-checksums.ts",
    "db:drift": "tsx src/drift-check.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
