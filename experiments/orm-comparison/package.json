{
  "name": "@ipoint/orm-comparison",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx scripts/run-poc.ts",
    "infra:up": "docker compose -f compose.poc.yaml up -d --wait",
    "infra:down": "docker compose -f compose.poc.yaml down -v",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:migration": "prisma migrate diff --config prisma/prisma.config.ts --from-empty --to-schema prisma/schema.prisma --script -o prisma/migrations/0001_initial/migration.sql",
    "drizzle:migration": "drizzle-kit generate --config drizzle/drizzle.config.ts --name initial",
    "poc": "tsx scripts/run-poc.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.10",
    "prisma": "7.8.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
